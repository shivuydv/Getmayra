# MYRA Environment Secrets Template
# Copy this file to '.env' and fill in your actual keys.
# DO NOT commit your '.env' file to version control.

# Google Gemini API Key (Required for AI responses)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional fallback)
OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs API Key (Required for high-quality voice)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs Voice ID (Optional - defaults to Rachel)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
